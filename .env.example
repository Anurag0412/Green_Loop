# DATABASE_URL: Supabase PostgreSQL connection string (Session Pooler port 5432 or Transaction Pooler port 6543).
# Accessed strictly on the server via node-postgres (pg). Never expose to browser.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth Configuration (Public URL & Publishable/Anon Key — never expose service_role key to client)
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_ANON_KEY"

# GEMINI_API_KEY: Required for server-side Gemini AI visual crop quality assessment.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
